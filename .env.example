# Use demo for SQLite plus in-memory documents, or mongodb for SQLite plus MongoDB.
APP_MODE=demo
SQLITE_PATH=data/shopsphere.db
MARIADB_HOST=127.0.0.1
MARIADB_PORT=3306
MARIADB_DATABASE=shopsphere
MARIADB_USER=shopsphere
MARIADB_PASSWORD=change-me
# Local development URI; keep the MongoDB port bound to localhost.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=shopsphere
